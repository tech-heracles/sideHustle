<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to machineKey.config and generate new random keys (validationKey: 128 hex chars, decryptionKey: 64 hex chars).
     PowerShell: -join ((1..64) | % { '{0:X2}' -f (Get-Random -Max 256) }) -->
<machineKey validation="HMACSHA256" validationKey="GENERATE-128-HEX-CHARS" decryption="AES" decryptionKey="GENERATE-64-HEX-CHARS" />
