<?xml version="1.0" encoding="utf-8"?>
<!--
  Kopjoje si avecLicense.config (git-ignored) ne kete dosje dhe ne dosjen e site-it, dhe plotesoje per kete server.
  Web.config e lexon me <appSettings file="avecLicense.config">.

  Instalimi dhe celesi krijohen ne manager-backend/functions:
      node scripts/avec-admin.mjs installation <installationId> "<emri i serverit>"
  (celesi shfaqet vetem nje here). Kompanite i caktohen instalimit me:
      node scripts/avec-admin.mjs company <companyId> --installation <installationId> --start 2026-01-01 --end 2026-12-31
          --type onPremise|cloud --connection "<connection string i databazes se kompanise>"
-->
<appSettings>
  <add key="AvecLicenseUrl" value="https://europe-west1-poss-66570.cloudfunctions.net/avecLicenses" />
  <add key="AvecInstallationId" value="" />
  <add key="AvecInstallationKey" value="" />
</appSettings>
