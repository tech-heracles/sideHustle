<?xml version="1.0" encoding="utf-8"?>
<!--
  Kopjoje si avecLicense.config (git-ignored) ne kete dosje dhe ne dosjen e site-it, dhe plotesoje per kete server.
  Web.config e lexon me <appSettings file="avecLicense.config">.

  Celesi i serverit krijohet ne manager-backend/functions (shfaqet vetem nje here):
      node scripts/avec-admin.mjs installation <installationId> "<emri i serverit>"
  Lista e kompanive = te gjitha kompanite me ERP "AVEC Accounting" (Manager > Data Source: instanca, databaza,
  perdoruesi, fjalekalimi). Licenca: companies/{id}.avecAccounting = { startDate, endDate, active } ne konsolen e Firebase.
-->
<appSettings>
  <add key="AvecLicenseUrl" value="https://europe-west8-poss-66570.cloudfunctions.net/avecLicenses" />
  <add key="AvecInstallationId" value="" />
  <add key="AvecInstallationKey" value="" />

  <!-- Vlerat e ketij skedari kane perparesi mbi ato te Web.config. Web.config ka adresat TEST te tatimeve; ne serverin
       e klientit (prodhim) vendosni ketu adresat dhe kodet e tyre te prodhimit, te kopjuara nga Web.config aktual i
       serverit para se ta zevendesoni. Pa to faturat fiskalizohen ne mjedisin test dhe nuk jane te vlefshme.
  <add key="urlEinvoice" value="https://einvoice.tatime.gov.al/EinvoiceService-v1/EinvoiceService.wsdl" />
  <add key="urlFiskalizimi" value="https://efiskalizimi.tatime.gov.al/FiscalizationService-v3/FiscalizationService.wsdl" />
  <add key="urlFiskalizimiApp" value="https://efiskalizimi-app.tatime.gov.al/invoice-check/#/verify?iic=" />
  <add key="kodSoftueri" value="" />
  <add key="kodMirembajtesi" value="" />
  <add key="webhookAuthToken" value="" />
  -->
</appSettings>
