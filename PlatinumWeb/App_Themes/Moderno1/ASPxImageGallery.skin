<%@ Register TagPrefix="dx" Namespace="DevExpress.Data" Assembly="DevExpress.Data.v18.2, Version=18.2.7.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dx" Namespace="DevExpress.Web" Assembly="DevExpress.Web.v18.2, Version=18.2.7.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>

<dx:ASPxImageGallery runat="server" PagerPanelSpacing="0px">
    <Images SpriteCssFilePath="{0}/sprite.css">
    </Images>

    <Styles CssPostfix="Moderno1" CssFilePath="{0}/styles.css"></Styles>

    <PagerSettings CurrentPageNumberFormat="{0}">
        <AllButton Text=""></AllButton>
        <PageSizeItemSettings Visible="True">
        </PageSizeItemSettings>
    </PagerSettings>
</dx:ASPxImageGallery>

