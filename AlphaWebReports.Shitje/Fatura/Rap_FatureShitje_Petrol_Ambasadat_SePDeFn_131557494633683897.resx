           double sasiatvsh= Convert.ToDouble(GetCurrentColumnValue("SASIA"));
            double cmimTVSH = Convert.ToDouble(GetCurrentColumnValue("CmimiMeTvshTrupi"));
            shumaTVSH += sasiatvsh * cmimTVSH;
            sasia_total_tvsh += sasiatvsh;
}

